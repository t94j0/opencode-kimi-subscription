{
  // Minimal setup: just add the plugin. It self-registers the "kimi-code"
  // provider and its models, and adds "Sign in with Kimi (subscription)" to
  // `opencode auth login`.
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-kimi-subscription"],

  // During local development, `npm run build` and point at the built output:
  // "plugin": ["/absolute/path/to/opencode-kimi-subscription/dist/index.js"]
}
