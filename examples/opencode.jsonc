{
  // Minimal setup: just add the plugin. It self-registers the "kimi-code"
  // provider and its models, and adds "Sign in with Kimi (subscription)" to
  // the model picker / /connect.
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-kimi-subscription"],

  // Local fork (this repo, OpenCode 2.x build) — point at the repo root:
  // "plugin": ["d:/AI_PetProjects/opencode-kimi-subscription"]
}
